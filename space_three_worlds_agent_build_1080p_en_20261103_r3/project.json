{
  "schema_version": 1,
  "title": "Space Three Worlds Vlog",
  "order": [
    "01_intro",
    "02_aether_tour",
    "03_toolbar",
    "04_agent",
    "05_chinook_prompt",
    "06_chinook_inspect",
    "07_chinook_refine",

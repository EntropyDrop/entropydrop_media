  "format": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "language": "English",
    "subtitles": false
  },
  "encoder": {
    "preset": "fast",
    "crf": 18,
    "threads": 4
  },
  "narration_timing": {
    "lead": 0.2,
    "gap": 0.25,
    "tail": 0.35,
    "trim_rms": 100,
    "trim_before": 0.08,
    "trim_after": 0.12
  },
  "audio": {
    "ambient": "audios/ambient_original.wav",
    "ambient_gain": 0.75,
    "limiter": 0.89,
    "voice_filter": "loudnorm=I=-16:TP=-1.5:LRA=7",
    "preview_filter": "loudnorm=I=-16:TP=-1.5:LRA=7"
  },
  "tts": {
    "url": "http://192.168.0.10:8008/v1/audio/speech",
    "request": {
      "model": "qwen3-tts",
      "voice": "entropydrop",
      "language": "English",
      "response_format": "wav"
    }
  },
  "output": "exports/space_three_worlds_latest.mp4",
  "source_baseline": "R3, unchanged movie retained in exports/space_three_worlds_agent_build_1080p_en_r3.mp4",
  "workflow": "Edit modules in this same folder. Never create an R4/R5 project clone for local edits. Run build for selected modules, then assemble to refresh latest.",
  "excluded": [
    "14_rover_light_a",
    "15_rover_light_b"
  ]
}
